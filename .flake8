[flake8]
max-line-length = 120

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    dist,
    build

ignore =
    E203,
    E712,
    W503

per-file-ignores =
    __init__.py: F401
    app/tests/*: F401
    app/scripts/seed_users.py: F401
    app/worker/tasks.py: F401
    */migrations/*: F401
